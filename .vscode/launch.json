{
    // F5 = debug, Ctrl+F5 = run without debugging. Requires the CodeLLDB
    // extension (vadimcn.vscode-lldb); the build goes through `nix develop`.
    "version": "0.2.0",
    "configurations": [
        {
            "name": "dupotDevTools (debug)",
            "type": "lldb",
            "request": "launch",
            "preLaunchTask": "cargo build",
            "program": "${workspaceFolder}/target/debug/dupot-dev-tools",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/target/vscode.env",
            "sourceLanguages": ["rust"]
        },
        {
            "name": "dupotDevTools (release)",
            "type": "lldb",
            "request": "launch",
            "preLaunchTask": "cargo build --release",
            "program": "${workspaceFolder}/target/release/dupot-dev-tools",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/target/vscode.env",
            "sourceLanguages": ["rust"]
        }
    ]
}
