{
    // Requires the CodeLLDB extension; open VSCode from `nix develop` so
    // cargo and the GTK libraries are on the environment.
    "version": "0.2.0",
    "configurations": [
        {
            "name": "dupotDevTools",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": ["build", "--bin=dupot-dev-tools"]
            },
            "cwd": "${workspaceFolder}"
        }
    ]
}
