{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "cargo build",
            "type": "shell",
            "command": "${workspaceFolder}/.vscode/nix-cargo.sh",
            "args": ["build"],
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$rustc"]
        },
        {
            "label": "cargo build --release",
            "type": "shell",
            "command": "${workspaceFolder}/.vscode/nix-cargo.sh",
            "args": ["build", "--release"],
            "group": "build",
            "problemMatcher": ["$rustc"]
        },
        {
            "label": "cargo run",
            "type": "shell",
            "command": "${workspaceFolder}/.vscode/nix-cargo.sh",
            "args": ["run"],
            "problemMatcher": ["$rustc"]
        },
        {
            "label": "cargo test",
            "type": "shell",
            "command": "${workspaceFolder}/.vscode/nix-cargo.sh",
            "args": ["test"],
            "group": { "kind": "test", "isDefault": true },
            "problemMatcher": ["$rustc"]
        },
        {
            "label": "cargo clippy",
            "type": "shell",
            "command": "${workspaceFolder}/.vscode/nix-cargo.sh",
            "args": ["clippy", "--all-targets"],
            "problemMatcher": ["$rustc"]
        }
    ]
}
